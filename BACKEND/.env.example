PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Long random string used to sign login tokens (REQUIRED in production)
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://kalapila-chat.vercel.app
BACKEND_URL=https://kalapila.onrender.com
# Max upload size in MB (files are stored in MongoDB GridFS)
MAX_UPLOAD_MB=25
# Optional TURN server for calls over mobile data / strict networks
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
